{
  "name": "dsh-plugin-runbook",
  "version": "0.10.0",
  "description": "Live data-flow runbook for DeepSeek Harness (DSH): scrubbable turn-by-turn DAG of every artifact an agent produced — mini-terminal rerun, LLM explain, git provenance nodes, subagent stitching, disk-scan static IO inference, PIPELINE.md backbone. Local-first.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhan-tz/dsh-plugin-runbook.git"
  },
  "homepage": "https://github.com/zhan-tz/dsh-plugin-runbook#readme",
  "bugs": {
    "url": "https://github.com/zhan-tz/dsh-plugin-runbook/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "runbook",
    "dag",
    "dataflow",
    "provenance",
    "web-ui",
    "jupyter"
  ],
  "license": "MIT"
}