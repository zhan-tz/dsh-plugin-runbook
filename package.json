{
  "name": "dsh-plugin-runbook",
  "version": "0.2.0",
  "description": "DSH 插件：Jupyter 式活体运行本——回合可回放的数据流 DAG。git 提交出处、子 agent 交接、持久账本、磁盘扫描+静态 IO 推断（未运行/未推送的研究代码也进图）、悬停重跑与 LLM 解释。全本地。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhan-tz/dsh-plugin-runbook.git"
  },
  "homepage": "https://github.com/zhan-tz/dsh-plugin-runbook#readme",
  "bugs": {
    "url": "https://github.com/zhan-tz/dsh-plugin-runbook/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "runbook",
    "dag",
    "dataflow",
    "provenance",
    "web-ui",
    "jupyter"
  ],
  "license": "MIT"
}